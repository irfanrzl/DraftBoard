{
  "name": "draftboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "parse": "tsx src/cli.ts parse",
    "generate": "tsx src/cli.ts generate",
    "scaffold": "tsx src/cli.ts create",
    "parse-image": "tsx src/cli.ts parse-image",
    "scaffold-image": "tsx src/cli.ts scaffold-image",
    "web": "npm --prefix web install && npm --prefix web run build && tsx src/server.ts",
    "web:dev": "tsx src/server.ts",
    "site": "tsx src/cli.ts site",
    "parse-tokens": "tsx src/cli.ts parse-tokens",
    "test": "vitest run"
  },
  "dependencies": {
    "@dbml/core": "^3.9.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
